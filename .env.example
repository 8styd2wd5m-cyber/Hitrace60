# Public Supabase browser/server URL. Safe to expose.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase anon key. Safe to expose, protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase service role key. Never expose in browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public app base URL used for admin/display links.
NEXT_PUBLIC_APP_URL=https://your-staging-domain.vercel.app

# Public judge/display QR base URL. Usually the same as NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_JUDGE_BASE_URL=https://your-staging-domain.vercel.app

# Server-only safety gate. Recommended default for staging/production.
ALLOW_DEMO_FALLBACK=false

# Reserved for future judge token hardening. Not used by the current runtime.
JUDGE_TOKEN_SECRET=change-me-with-a-long-random-secret
